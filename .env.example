RUNPOD_API_KEY=

ENDPOINT_NAME=vllm-private
MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3

HF_TOKEN=

# GPU tier code (NOT a display name). Common options:
#   AMPERE_16   - 16GB Ampere (cheapest)
#   AMPERE_24   - 24GB Ampere (RTX 3090 class)
#   ADA_24      - 24GB Ada Lovelace (RTX 4090 class), best perf/$
#   AMPERE_48   - 48GB (A6000)
#   ADA_48_PRO  - 48GB Ada Pro
#   AMPERE_80   - 80GB (A100)
#   ADA_80_PRO  - 80GB Ada Pro (H100)
GPU_IDS=ADA_24

MIN_WORKERS=0
MAX_WORKERS=1
IDLE_TIMEOUT=30

CONTAINER_DISK_GB=20
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.9

# Worker image — see https://hub.docker.com/r/runpod/worker-v1-vllm/tags
IMAGE=runpod/worker-v1-vllm:v2.20.0

# Docker Hub credentials (optional, but avoids rate limits on pulls)
# NOTE: RunPod's container registry auth doesn't support PATs (dckr_pat_...).
#       Unauthenticated pulls work fine for public images.
# DOCKER_USERNAME=
# DOCKER_PASSWORD=

# Filled in by deploy.sh — don't edit manually
TEMPLATE_ID=
ENDPOINT_ID=
